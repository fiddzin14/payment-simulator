{
  "name": "lumen/payment-gateway-simulator",
  "type": "project",
  "description": "Laravel multi-merchant QRIS and virtual account sandbox",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "bacon/bacon-qr-code": "^3.0",
    "dompdf/dompdf": "^3.1",
    "laravel/framework": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
